---
// StackWord — ResultsCard: End-of-game summary card with score, accuracy, and share link

interface Props {
  score?: number;
  maxCombo?: number;
  xp?: number;
  streak?: number;
  theme?: string;
  date?: string;
}

const { score = 0, maxCombo = 0, xp = 0, streak = 0, theme = '', date = '' } = Astro.props;
---

<div class="w-full max-w-md mx-auto">
  <div
    class="relative overflow-hidden rounded-2xl border border-violet-500/30 bg-gradient-to-br from-slate-800 via-slate-900 to-slate-800 p-6 shadow-xl shadow-violet-500/10"
  >
    <!-- Decorative glow -->
    <div class="absolute -top-16 -right-16 w-32 h-32 bg-violet-500/20 rounded-full blur-3xl pointer-events-none" />
    <div class="absolute -bottom-16 -left-16 w-32 h-32 bg-pink-500/20 rounded-full blur-3xl pointer-events-none" />

    <!-- Header -->
    <div class="relative text-center mb-6">
      <div class="text-4xl mb-2">🏆</div>
      <h2 class="text-2xl font-bold bg-gradient-to-r from-violet-300 to-pink-300 bg-clip-text text-transparent">
        Puzzle Complete!
      </h2>
      {theme && (
        <p class="text-slate-400 text-sm mt-1">Theme: {theme}</p>
      )}
      {date && (
        <p class="text-slate-500 text-xs mt-0.5">{date}</p>
      )}
    </div>

    <!-- Stats Grid -->
    <div class="relative grid grid-cols-2 gap-3 mb-6">
      <div class="bg-slate-800/80 rounded-xl p-4 text-center border border-slate-700/50">
        <p class="text-2xl font-bold text-white">{score}</p>
        <p class="text-slate-400 text-xs uppercase tracking-wider mt-1">Score</p>
      </div>
      <div class="bg-slate-800/80 rounded-xl p-4 text-center border border-slate-700/50">
        <p class="text-2xl font-bold text-amber-400">{maxCombo}x</p>
        <p class="text-slate-400 text-xs uppercase tracking-wider mt-1">Max Combo</p>
      </div>
      <div class="bg-slate-800/80 rounded-xl p-4 text-center border border-slate-700/50">
        <p class="text-2xl font-bold text-emerald-400">+{xp}</p>
        <p class="text-slate-400 text-xs uppercase tracking-wider mt-1">XP Earned</p>
      </div>
      <div class="bg-slate-800/80 rounded-xl p-4 text-center border border-slate-700/50">
        <p class="text-2xl font-bold text-orange-400">
          🔥 {streak}
        </p>
        <p class="text-slate-400 text-xs uppercase tracking-wider mt-1">Day Streak</p>
      </div>
    </div>

    <!-- Share Button -->
    <button
      id="results-share-btn"
      class="relative w-full py-3 rounded-xl font-semibold text-sm bg-gradient-to-r from-violet-600 to-pink-600 text-white transition-all duration-200
             hover:from-violet-500 hover:to-pink-500 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2 focus:ring-offset-slate-900"
    >
      📋 Share Results
    </button>

    <!-- Play Again Message -->
    <p class="relative text-center text-slate-500 text-sm mt-4">
      Come back tomorrow for a new puzzle!
    </p>
  </div>
</div>

<style is:global>
  #results-share-btn:active {
    transform: scale(0.98);
  }
</style>
