---
// StackWord — StreakIndicator: Visual flame indicator for daily streak

interface Props {
  streak?: number;
}

const { streak = 0 } = Astro.props;
---

<div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-800/60 backdrop-blur-sm">
  {streak > 0 ? (
    <span class="text-2xl drop-shadow-[0_0_8px_rgba(251,146,60,0.7)] animate-pulse" aria-label={`${streak} day streak`}>🔥</span>
  ) : (
    <span class="text-2xl opacity-50">🔥</span>
  )}
  <span class="text-white font-bold text-sm sm:text-base">
    {streak > 0 ? `${streak} day${streak > 1 ? 's' : ''}` : 'Start your streak!'}
  </span>
</div>
