---
// StackWord — HintButton: Reveal one letter of an unfound word

interface Props {
  remaining?: number;
}

const { remaining = 0 } = Astro.props;
---

<button
  id="hint-btn"
  class="relative inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200
         border border-slate-600 bg-slate-800/80 text-slate-200 cursor-pointer
         hover:bg-slate-700 hover:border-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2 focus:ring-offset-slate-900
         disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-slate-800/80 disabled:hover:border-slate-600"
  disabled={remaining <= 0}
  aria-label={`Use a hint (${remaining} remaining)`}
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
  </svg>
  <span>
    Hint <span class="text-violet-400 font-bold">{remaining}</span>
  </span>
</button>

<style is:global>
  #hint-btn:active:not(:disabled) {
    transform: scale(0.97);
  }
</style>
