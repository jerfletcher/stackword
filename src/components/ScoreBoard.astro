---
// StackWord — ScoreBoard: Displays score, combo, high score, and XP progress
import { getDailyPuzzle } from '../client/words.js';
const puzzle = getDailyPuzzle();
---

<div class="w-full max-w-lg mx-auto px-4 py-3">
  <!-- Score Row -->
  <div class="text-center mb-2">
    <div class="flex items-center justify-center gap-2">
      <span id="sw-score" class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-indigo-400 tabular-nums">0</span>
      <span id="sw-combo-badge" class="text-sm font-bold px-2 py-0.5 rounded-full bg-violet-600/30 text-violet-300 opacity-0 transition-all duration-300">
        1x
      </span>
    </div>
    <p class="text-xs text-gray-500 mt-0.5 tracking-wide uppercase">Score</p>
  </div>

  <!-- Stats Row -->
  <div class="flex justify-between items-center text-xs text-gray-400 mb-2">
    <span>
      🏆 <span id="sw-high-score" class="text-amber-400 font-semibold">—</span>
      <span class="text-gray-600 ml-1">high</span>
    </span>
    <span class="text-gray-600">
      <span id="sw-puzzle-date"></span>
    </span>
  </div>

  <!-- XP Bar -->
  <div class="relative">
    <div class="flex justify-between text-[10px] text-gray-500 mb-1">
      <span>Level <span id="sw-level" class="text-violet-400 font-semibold">1</span></span>
      <span id="sw-xp-text">0 XP</span>
    </div>
    <div class="h-2 bg-gray-800 rounded-full overflow-hidden">
      <div id="sw-xp-bar" class="h-full bg-gradient-to-r from-violet-500 to-indigo-500 rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
    </div>
  </div>
</div>

<script type="module" src="/client/scoreboard.js?v=2"></script>
