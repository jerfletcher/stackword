---
// StackWord — GameBoard: Main interactive gameplay component
import { getDailyPuzzle } from '../client/words.js';
const puzzle = getDailyPuzzle();
---

<div class="w-full max-w-lg mx-auto px-4">
  <!-- Word Input Display -->
  <div class="text-center mb-6 min-h-[4rem] flex items-center justify-center">
    <div id="sw-current-word" class="text-3xl font-bold tracking-wider text-white min-h-[2.5rem] flex items-center">
      <span class="text-gray-600 text-lg font-normal">Tap letters to build a word</span>
    </div>
  </div>

  <!-- Found Words Stack Area -->
  <div id="sw-found-words" class="space-y-2 mb-6 min-h-[3rem]">
    <!-- Found words appear here -->
  </div>

  <!-- Progress Indicator -->
  <div class="text-center mb-4">
    <span id="sw-progress" class="text-sm text-gray-500"></span>
  </div>

  <!-- Letter Tiles -->
  <div id="sw-letter-tiles" class="flex flex-wrap justify-center gap-2 mb-6">
    <!-- Letter tiles rendered by client script -->
  </div>

  <!-- Action Buttons -->
  <div class="flex gap-3 justify-center mb-8">
    <button id="sw-clear-btn" class="flex-1 max-w-[140px] px-4 py-3 bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold rounded-xl transition-all duration-200 active:scale-95 text-sm">
      Clear
    </button>
    <button id="sw-check-btn" class="flex-1 max-w-[200px] px-4 py-3 bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white font-bold rounded-xl transition-all duration-200 active:scale-95 shadow-lg shadow-violet-500/25 text-sm">
      Check Word
    </button>
  </div>

  <!-- Results Card (hidden by default) -->
  <div id="sw-results" class="hidden text-center py-6">
    <div class="bg-gradient-to-b from-gray-800 to-gray-900 rounded-2xl p-6 border border-gray-700">
      <h2 class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-400 mb-4">
        🏆 Puzzle Complete!
      </h2>
      <div class="space-y-3 mb-6">
        <div class="flex justify-between items-center py-2 border-b border-gray-700">
          <span class="text-gray-400 text-sm">Score</span>
          <span id="sw-result-score" class="text-xl font-bold text-white">0</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-gray-700">
          <span class="text-gray-400 text-sm">Words Found</span>
          <span id="sw-result-words" class="text-white font-semibold">0/0</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-gray-700">
          <span class="text-gray-400 text-sm">Max Combo</span>
          <span id="sw-result-combo" class="text-violet-400 font-bold">0x</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-gray-700">
          <span class="text-gray-400 text-sm">XP Earned</span>
          <span id="sw-result-xp" class="text-emerald-400 font-bold">+0</span>
        </div>
        <div class="flex justify-between items-center py-2">
          <span class="text-gray-400 text-sm">🔥 Streak</span>
          <span id="sw-result-streak" class="text-amber-400 font-bold">0 days</span>
        </div>
      </div>
      <button id="sw-share-btn" class="w-full px-4 py-3 bg-gray-700 hover:bg-gray-600 text-white font-semibold rounded-xl transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 text-sm">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.5.46 1.19.76 1.96.76 1.54 0 2.79-1.25 2.79-2.79S19.54 2.37 18 2.37 15.21 3.62 15.21 5.16c0 .24.04.47.09.7L8.25 9.97C7.76 9.49 7.08 9.2 6.34 9.2 4.8 9.2 3.54 10.45 3.54 12s1.26 2.79 2.8 2.79c.74 0 1.42-.29 1.91-.77l7.11 4.15c-.05.21-.08.43-.08.66 0 1.54 1.25 2.79 2.79 2.79s2.79-1.25 2.79-2.79-1.25-2.79-2.79-2.79z"/></svg>
        Share Results
      </button>
      <p id="sw-share-copy-feedback" class="text-emerald-400 text-xs mt-2 hidden">Copied to clipboard!</p>
    </div>
  </div>
</div>

<style>
  /* Word entry animation */
  @keyframes swSlideIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Wrong guess shake */
  @keyframes swShake {
    0%, 100% { transform: translateX(0); }
    10%, 50%, 90% { transform: translateX(-6px); }
    30%, 70% { transform: translateX(6px); }
  }

  /* Combo glow pulse */
  @keyframes swGlow {
    0%, 100% {
      box-shadow: 0 0 8px rgba(139, 92, 246, 0.3);
    }
    50% {
      box-shadow: 0 0 20px rgba(139, 92, 246, 0.6), 0 0 40px rgba(139, 92, 246, 0.2);
    }
  }

  /* Score increment bounce */
  @keyframes swBounce {
    0% { transform: scale(1); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }

  /* Tile press animation */
  @keyframes swTilePress {
    0% { transform: scale(1); }
    50% { transform: scale(0.9); }
    100% { transform: scale(1); }
  }

  .sw-word-entry {
    animation: swSlideIn 0.35s ease-out forwards;
  }

  .sw-shake {
    animation: swShake 0.4s ease-in-out;
  }

  .sw-combo-glow {
    animation: swGlow 1s ease-in-out infinite;
  }

  .sw-score-bounce {
    animation: swBounce 0.2s ease-out;
  }

  .sw-tile-press {
    animation: swTilePress 0.15s ease-out;
  }
</style>

<script type="module" src="../client/gameboard.js"></script>
