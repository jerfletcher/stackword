---
// StackWord — Home page
import ScoreBoard from '../components/ScoreBoard.astro';
import GameBoard from '../components/GameBoard.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="StackWord — Daily word stacking puzzle game" />
    <title>StackWord — Daily Word Puzzle</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>" />
  </head>
  <body class="bg-slate-900 text-white min-h-screen flex flex-col">
    <div class="flex-1 flex flex-col items-center justify-start py-4 sm:py-6">
      <!-- Header -->
      <header class="w-full max-w-lg px-4 pt-2 pb-1 text-center">
        <h1 class="text-3xl sm:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-purple-400 to-indigo-400 tracking-tight">
          StackWord
        </h1>
        <p class="text-xs text-gray-500 mt-1">Daily Word Puzzle</p>
      </header>

      <!-- Score Board -->
      <ScoreBoard />

      <!-- Game Board -->
      <GameBoard />

      <!-- Footer -->
      <footer class="w-full max-w-lg px-4 pb-4 text-center">
        <p class="text-[10px] text-gray-600">
          StackWord &copy; {new Date().getFullYear()} · One puzzle per day
        </p>
      </footer>
    </div>
  </body>
</html>
