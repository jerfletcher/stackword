---
// StackWord — Home page

import GameBoard from '../components/GameBoard.astro';
import ScoreBoard from '../components/ScoreBoard.astro';
import StreakIndicator from '../components/StreakIndicator.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>StackWord — Daily Word Game</title>
    <meta name="description" content="Stack words, build combos, keep your streak alive." />
  </head>
  <body class="bg-slate-900 text-white min-h-screen">
    <header class="flex justify-between items-center p-4">
      <h1 class="text-xl font-bold bg-gradient-to-r from-violet-400 to-pink-400 bg-clip-text text-transparent">
        StackWord
      </h1>
      <div class="flex items-center gap-3">
        <StreakIndicator />
        <ThemeToggle />
      </div>
    </header>
    <main class="flex flex-col items-center px-4 pb-8 gap-6">
      <ScoreBoard />
      <!-- Game content rendered by GameBoard client-side -->
      <GameBoard />
    </main>
  </body>
</html>
